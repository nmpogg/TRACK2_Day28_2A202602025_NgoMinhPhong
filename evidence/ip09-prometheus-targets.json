      "health": "ok",
      "duration": "120s",
      "labels": {
        "severity": "warning"
      },
      "annotations": {
        "summary": "More than 5 percent of Lab 28 requests are failing",
        "description": "Use the trace ID and readiness breakdown to identify the failing boundary."
      }
